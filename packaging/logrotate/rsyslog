/var/log/cron
/var/log/maillog
/var/log/messages
/var/log/secure
/var/log/spooler
{
    daily
    maxsize 256M
    rotate 28
    maxage 14
    missingok
    notifempty
    compress
    delaycompress
    dateext
    dateformat -%Y%m%d-%H%M%S
    create 0600 root root
    sharedscripts
    postrotate
        /usr/bin/systemctl kill --signal=HUP rsyslog.service >/dev/null 2>&1 || true
    endscript
}
