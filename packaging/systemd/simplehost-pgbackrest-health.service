[Unit]
Description=SimpleHost pgBackRest health guard
After=network-online.target postgresql@control.service postgresql@apps.service
Wants=network-online.target
OnFailure=simplehost-unit-failure@%n.service

[Service]
Type=oneshot
User=postgres
Group=postgres
EnvironmentFile=-/etc/simplehost/storage-resilience.env
WorkingDirectory=/opt/simplehostman/release/current
ExecStart=/usr/bin/node /opt/simplehostman/release/current/apps/worker/dist/pgbackrest-health-cycle.js
StateDirectory=simplehost-pgbackrest-health
StateDirectoryMode=0750
Nice=10
IOSchedulingClass=idle
IOSchedulingPriority=7
TimeoutStartSec=5min
NoNewPrivileges=true
