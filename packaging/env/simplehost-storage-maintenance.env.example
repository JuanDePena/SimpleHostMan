# Safe defaults for the root-owned SimpleHostMan storage maintenance timer.
SIMPLEHOST_STORAGE_ROOT_PATH=/
SIMPLEHOST_STORAGE_RELEASE_ROOT=/opt/simplehostman/release
SIMPLEHOST_STORAGE_BACKUP_ROOT=/srv/backups
SIMPLEHOST_STORAGE_GENESIS_RECOVERY_ROOT=/var/lib/pyrosa-platform/genesis-recovery
SIMPLEHOST_STORAGE_WATCHED_BACKUP_PATHS=/srv/backups/databases/pyrosa-sync
SIMPLEHOST_STORAGE_REPORT_PATH=/var/lib/simplehost/storage-maintenance/latest.json

# Apply only when the root filesystem reaches the high watermark. Release
# cleanup runs first; Podman image pruning runs only if usage remains at or
# above the target watermark.
SIMPLEHOST_STORAGE_HIGH_WATERMARK_PERCENT=85
SIMPLEHOST_STORAGE_TARGET_WATERMARK_PERCENT=80

# Releases are candidates only when they are older than the minimum age and
# outside the active, metadata-referenced, pinned and latest-N protection sets.
SIMPLEHOST_STORAGE_RELEASE_KEEP=5
SIMPLEHOST_STORAGE_RELEASE_MIN_AGE_DAYS=7
SIMPLEHOST_STORAGE_RELEASE_PINS=

# Podman removes only images unused by every container. Containers and volumes
# are never pruned by this service.
SIMPLEHOST_STORAGE_IMAGE_MIN_AGE_HOURS=168

# Optional comma-separated process fragments that should block apply mode.
SIMPLEHOST_STORAGE_BLOCKING_PROCESS_PATTERNS=
