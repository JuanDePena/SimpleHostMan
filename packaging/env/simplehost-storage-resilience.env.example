# Capacity guard observes each unique filesystem behind these paths.
SIMPLEHOST_CAPACITY_PATHS=/,/srv/backups
SIMPLEHOST_CAPACITY_WARNING_PERCENT=70
SIMPLEHOST_CAPACITY_CRITICAL_PERCENT=85
SIMPLEHOST_CAPACITY_WARNING_FREE_GIB=10
SIMPLEHOST_CAPACITY_CRITICAL_FREE_GIB=5
SIMPLEHOST_CAPACITY_REPORT_PATH=/var/lib/simplehost-capacity-guard/latest.json

# pgBackRest health fails closed when a full is older than eight days, the
# archive queue grows abnormally, metadata ownership changes, or the repository
# crosses the critical capacity threshold.
SIMPLEHOST_PGBACKREST_STANZAS=apps,control
SIMPLEHOST_PGBACKREST_REPO=/srv/backups/pgbackrest
SIMPLEHOST_PGBACKREST_MAX_FULL_AGE_HOURS=192
SIMPLEHOST_PGBACKREST_WARNING_READY_COUNT=64
SIMPLEHOST_PGBACKREST_CRITICAL_READY_COUNT=256
SIMPLEHOST_PGBACKREST_HEALTH_REPORT_PATH=/var/lib/simplehost-pgbackrest-health/latest.json

SIMPLEHOST_BACKUP_RETENTION_REPORT_PATH=/var/lib/simplehost-backup-retention/latest.json
SIMPLEHOST_LOG_HEALTH_ACTIVE_PATH=/var/log/messages
SIMPLEHOST_LOG_HEALTH_SERVICE=rsyslog.service
SIMPLEHOST_LOG_HEALTH_REPORT_PATH=/var/lib/simplehost-log-health/latest.json
SIMPLEHOST_UNIT_FAILURE_ROOT=/var/lib/simplehost-unit-failures
