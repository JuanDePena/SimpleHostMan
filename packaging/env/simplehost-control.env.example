NODE_ENV=development
SIMPLEHOST_VERSION=2606.11.18
SIMPLEHOST_CONTROL_RUNTIME_MODE=combined

SIMPLEHOST_API_HOST=127.0.0.1
SIMPLEHOST_API_PORT=3200
SIMPLEHOST_WEB_HOST=127.0.0.1
SIMPLEHOST_WEB_PORT=3200

SIMPLEHOST_DATABASE_URL=postgresql://simplehost_control:change-me@127.0.0.1:5433/simplehost_control
SIMPLEHOST_BOOTSTRAP_ENROLLMENT_TOKEN=change-me
SIMPLEHOST_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
SIMPLEHOST_BOOTSTRAP_ADMIN_PASSWORD=change-me
SIMPLEHOST_BOOTSTRAP_ADMIN_NAME=SimpleHost Admin
SIMPLEHOST_SESSION_TTL_SECONDS=43200
SIMPLEHOST_JOB_SECRET_KEY=change-me

# Optional Pyrosa IAM OAuth resource-server pilot.
# Disabled by default; enable only after configuring a dedicated client secret.
SIMPLEHOST_OAUTH_RESOURCE_SERVER_ENABLED=false
SIMPLEHOST_OAUTH_ISSUER=https://iam.pyrosa.com.do
SIMPLEHOST_OAUTH_AUTHORIZATION_URL=https://iam.pyrosa.com.do/oauth/authorize
SIMPLEHOST_OAUTH_TOKEN_URL=http://127.0.0.1:10134/oauth/token
SIMPLEHOST_OAUTH_INTROSPECTION_URL=http://127.0.0.1:10134/oauth/introspect
SIMPLEHOST_OAUTH_REVOCATION_URL=http://127.0.0.1:10134/oauth/revoke
SIMPLEHOST_OAUTH_CLIENT_ID=oauth-smoke
SIMPLEHOST_OAUTH_CLIENT_SECRET_FILE=/etc/simplehost/iam/pyrosa-iam/oauth-smoke-client-secret
SIMPLEHOST_OAUTH_REQUIRED_SCOPE=profile:read
SIMPLEHOST_OAUTH_REQUIRED_AUDIENCE=simplehost-control
SIMPLEHOST_OAUTH_REQUIRED_PRINCIPAL_TYPE=
SIMPLEHOST_OAUTH_REQUIRED_ASSURANCE_LEVEL=
SIMPLEHOST_OAUTH_PILOT_REDIRECT_URI=https://vps-prd.pyrosa.com.do:3200/v1/oauth/pilot/callback
SIMPLEHOST_OAUTH_PILOT_SCOPE=profile:read
SIMPLEHOST_OAUTH_PILOT_REQUIRED_PRINCIPAL_TYPE=human
SIMPLEHOST_OAUTH_PILOT_REQUIRED_ASSURANCE_LEVEL=aal2
SIMPLEHOST_OAUTH_PILOT_REVOKE_TOKENS=true
SIMPLEHOST_OAUTH_LOGIN_PROVIDER_SLUG=pyrosa-iam
SIMPLEHOST_OAUTH_LOGIN_ENABLED=false
SIMPLEHOST_OAUTH_LOGIN_REDIRECT_URI=https://vps-prd.pyrosa.com.do:3200/auth/pyrosa-iam/callback
SIMPLEHOST_OAUTH_LOGIN_SCOPE="profile:read mfa:read"
SIMPLEHOST_OAUTH_LOGIN_REQUIRED_PRINCIPAL_TYPE=human
SIMPLEHOST_OAUTH_LOGIN_REQUIRED_ASSURANCE_LEVEL=aal2
# Optional: leave blank to authorize only by active local SimpleHostMan operator.
SIMPLEHOST_OAUTH_LOGIN_REQUIRED_GROUP=
SIMPLEHOST_OAUTH_LOGIN_LOGOUT_URL=https://iam.pyrosa.com.do/logout
SIMPLEHOST_OAUTH_LOGIN_POST_LOGOUT_REDIRECT_URI=https://vps-prd.pyrosa.com.do:3200/login?notice=Session%20closed&kind=info
SIMPLEHOST_OAUTH_INTROSPECTION_TIMEOUT_MS=3000
